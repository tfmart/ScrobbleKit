{"abstract":[{"text":"A quick start guide on how to start using ScrobbleKit on your app","type":"text"}],"identifier":{"url":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/QuickStart","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","metadata":{"modules":[{"name":"ScrobbleKit"}],"role":"article","title":"Quick Start","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scrobblekit\/quickstart"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"level":3,"text":"Creating a Last.fm API Key","anchor":"Creating-a-Lastfm-API-Key","type":"heading"},{"inlineContent":[{"text":"To utilize the Last.fm API, obtain a valid API and Secret key. If you don’t have these keys, you can create them on the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/www.last.fm\/api\/account\/create"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"Add ScrobbleKit as a dependency","anchor":"Add-ScrobbleKit-as-a-dependency","type":"heading"},{"inlineContent":[{"text":"ScrobbleKit can be added to your projects through Swift Package Manager. If you’re adding it to another Swift Package, add ScrobbleKit to your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" file:","type":"text"}],"type":"paragraph"},{"code":["let package = Package(","    ...","    dependencies: [","        ...","        .package(url: \"https:\/\/github.com\/tfmart\/scrobblekit.git\", from: \"0.1.0\")","    ],","    targets: [","        .executableTarget(","            ...","            dependencies: [.product(name: \"ScrobbleKit\", package: \"ScrobbleKit\")],","            ...","        )","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For Xcode projects, search for the package with the repository URL ","type":"text"},{"code":"github.com\/tfmart\/scrobblekit","type":"codeVoice"},{"text":" to add it as a dependency to iOS, macOS, or macCatalyst targets.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Creating a SBKManager instance","anchor":"Creating-a-SBKManager-instance","type":"heading"},{"inlineContent":[{"text":"After integrating ScrobbleKit, instantiate the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager"},{"text":" using the ","type":"text"},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager\/init(apiKey:secret:)","isActive":true},{"text":" initializer. This class facilitates the invocation of available API methods, utilizing the API and Secret keys provided during initialization.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let manager = SBKManager(apiKey: API_KEY,","                         secret: SECRET_KEY)"]},{"inlineContent":[{"text":"Throughout your app, use this manager class to access Last.fm API methods provided in the library. Since ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager"},{"text":" is an actor that conditionally conforms to ","type":"text"},{"code":"ObservableObject","type":"codeVoice"},{"text":" when Combine is available, in a SwiftUI app, share this instance through a ","type":"text"},{"code":"StateObject","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@main","struct MyMusicApp: App {","    @StateObject var manager = SBKManager(apiKey: API_KEY,","                                          secret: SECRET_KEY)","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environmentObject(manager)","        }","    }","}"]},{"inlineContent":[{"text":"Subsequently, import the manager property into a view:","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @EnvironmentObject var manager: SBKManager","","    var body: some View {","        \/\/ ...","    }","}",""],"type":"codeListing","syntax":"swift"},{"text":"Calling API methods","type":"heading","level":3,"anchor":"Calling-API-methods"},{"type":"paragraph","inlineContent":[{"text":"To utilize any of the available methods, refer to the list under the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager"},{"text":" documentation. All methods use Swift’s modern Async\/Await concurrency pattern for safe, efficient data fetching.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For instance, to retrieve information from an album in the Last.fm database, utilize the  "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager\/getInfo(forAlbum:autoCorrect:username:languageCode:)","isActive":true},{"type":"text","text":" method:"}],"type":"paragraph"},{"code":["do {","    let album = try await manager.getInfo(forAlbum: .albumArtist(album: \"Random Access Memories\",","                                                                 artist: \"Daft Punk\"))","    \/\/ Use 'album' here","} catch {","    \/\/ Handle error","}"],"syntax":"swift","type":"codeListing"},{"name":"Note","style":"note","content":[{"inlineContent":[{"text":"Since ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager","isActive":true,"type":"reference"},{"type":"text","text":" is an actor, all method calls are inherently thread-safe and must be called with "},{"type":"codeVoice","code":"await"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit"]]},"references":{"doc://ScrobbleKit/documentation/ScrobbleKit/SBKManager/init(apiKey:secret:)":{"type":"topic","abstract":[{"text":"Creates a new instance of the