{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Scrobbling Tracks","role":"article","modules":[{"name":"ScrobbleKit"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResponse","doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager\/scrobble(tracks:)"],"anchor":"Track-Scrobbling","title":"Track Scrobbling","generated":true}],"sections":[],"hierarchy":{"paths":[["doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/Scrobbling"},"kind":"article","abstract":[{"type":"text","text":"Get started on scrobbling songs to a Last.fm profile"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/scrobblekit\/scrobbling"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure you are authenticated with a valid session token for a Last.fm account before initiating the scrobbling process. If you haven’t authenticated yet, If you need help on how to authenticate, refer to the "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/Authentication","isActive":true},{"type":"text","text":" for assistance."}]},{"anchor":"Scrobbling-a-Single-Track","type":"heading","level":3,"text":"Scrobbling a Single Track"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To scrobble a single track, you can use the "},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method with an array containing just one "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKTrackToScrobble","isActive":true},{"type":"text","text":":"}]},{"code":["let track = SBKTrackToScrobble(","    artist: \"Daft Punk\",","    track: \"One More Time\",","    timestamp: Date(),","    album: \"Discovery\"",")","","do {","    let response = try await manager.scrobble(tracks: [track])","    ","    if response.isCompletelySuccessful {","        print(\"Track scrobbled successfully!\")","    } else {","        if let result = response.results.first {","            if result.isAccepted {","                print(\"Scrobbled: \\(result.track.artist) - \\(result.track.track)\")","                if let correctedArtist = result.correctedArtist {","                    print(\"Artist corrected to: \\(correctedArtist)\")","                }","                if let correctedTrack = result.correctedTrack {","                    print(\"Track corrected to: \\(correctedTrack)\")","                }","            } else if let error = result.error {","                print(\"Failed to scrobble \\(result.track.artist) - \\(result.track.track): \\(error.rawValue)\")","            }","        }","    }","} catch {","    \/\/ Handle scrobbling error","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Scrobbling-Multiple-Tracks","type":"heading","level":3,"text":"Scrobbling Multiple Tracks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To scrobble multiple tracks at once, use the "},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method:"}]},{"code":["let tracks: [SBKTrackToScrobble] = [","    SBKTrackToScrobble(artist: \"Daft Punk\", track: \"One More Time\", timestamp: Date(), album: \"Discovery\"),","    SBKTrackToScrobble(artist: \"Daft Punk\", track: \"Harder, Better, Faster, Stronger\", timestamp: Date(), album: \"Discovery\")","]","","do {","    let response = try await manager.scrobble(tracks: tracks)","    ","    if response.isCompletelySuccessful {","        print(\"All tracks scrobbled successfully!\")","    } else {","        print(\"Accepted: \\(response.acceptedCount), Ignored: \\(response.ignoredCount)\")","        ","        for result in response.results {","            if result.isAccepted {","                print(\"Scrobbled: \\(result.track.artist) - \\(result.track.track)\")","            } else if let error = result.error {","                print(\"Failed to scrobble \\(result.track.artist) - \\(result.track.track): \\(error.rawValue)\")","            }","        }","    }","} catch {","    \/\/ Handle scrobbling error","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Handling-the-response","type":"heading","level":3,"text":"Handling the response"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method returns an "},{"type":"codeVoice","code":"SBKScrobbleResponse"},{"type":"text","text":" object, which contains:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"results"},{"text":": An array of ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","type":"reference","isActive":true},{"text":" objects, one for each track attempted to be scrobbled.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"acceptedCount"},{"type":"text","text":": The number of tracks successfully scrobbled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ignoredCount"},{"text":": The number of tracks that failed to scrobble.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isCompletelySuccessful","type":"codeVoice"},{"type":"text","text":": A boolean indicating if all tracks were successfully scrobbled."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"acceptedScrobbles","type":"codeVoice"},{"type":"text","text":": An array of "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","isActive":true},{"text":" objects for successfully scrobbled tracks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ignoredScrobbles","type":"codeVoice"},{"text":": An array of ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult"},{"type":"text","text":" objects for tracks that failed to scrobble."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"code":"SBKScrobbleResult","type":"codeVoice"},{"type":"text","text":" contains:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"track","type":"codeVoice"},{"text":": The ","type":"text"},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKTrackToScrobble","isActive":true},{"type":"text","text":" object that was attempted to be scrobbled."}]}]},{"content":[{"inlineContent":[{"code":"isAccepted","type":"codeVoice"},{"type":"text","text":": A boolean indicating if the track was successfully scrobbled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"error"},{"type":"text","text":": An "},{"isActive":true,"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleError"},{"type":"text","text":" object if the scrobble failed, "},{"code":"nil","type":"codeVoice"},{"text":" otherwise.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"correctedTrack"},{"text":", ","type":"text"},{"type":"codeVoice","code":"correctedArtist"},{"type":"text","text":", "},{"type":"codeVoice","code":"correctedAlbum"},{"type":"text","text":", "},{"type":"codeVoice","code":"correctedAlbumArtist"},{"type":"text","text":": Corrected values if Last.fm made any corrections."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"You can scrobble up to 50 tracks in a single request. Attempting to scrobble more than 50 tracks will result in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKClientError\/tooManyTracks","isActive":true},{"type":"text","text":" error."}]},{"type":"heading","text":"Convenience Methods","anchor":"Convenience-Methods","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager","isActive":true},{"type":"text","text":" provides two convenience methods for checking scrobble results:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check if a specific track was successfully scrobbled","let wasScrobbled = manager.scrobbledSuccessfully(tracks[0], in: response)","","\/\/ Get the error for a specific track, if any","if let error = manager.errorFor(tracks[1], in: response) {","    print(\"Scrobble failed: \\(error.rawValue)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These methods provide a quick way to check if the single track was scrobbled successfully or if there was an error."}]}]}],"references":{"doc://ScrobbleKit/documentation/ScrobbleKit/SBKScrobbleResult":{"type":"topic","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","navigatorTitle":[{"text":"SBKScrobbleResult","kind":"identifier"}],"url":"\/documentation\/scrobblekit\/sbkscrobbleresult","title":"SBKScrobbleResult","kind":"symbol","abstract":[{"text":"Represents the result of a scrobble attempt for a single track.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SBKScrobbleResult","kind":"identifier"}]},"doc://ScrobbleKit/documentation/ScrobbleKit/Authentication":{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/Authentication","abstract":[{"type":"text","text":"For services requiring authentication, discover how to sign in with a Last.fm account using ScrobbleKit."}],"kind":"article","type":"topic","role":"article","title":"Authenticating an User","url":"\/documentation\/scrobblekit\/authentication"},"doc://Scr