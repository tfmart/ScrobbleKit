{"abstract":[{"text":"Get started on scrobbling songs to a Last.fm profile","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Ensure you are authenticated with a valid session token for a Last.fm account before initiating the scrobbling process. If you haven’t authenticated yet, If you need help on how to authenticate, refer to the ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/Authentication","isActive":true,"type":"reference"},{"type":"text","text":" for assistance."}]},{"text":"Scrobbling a Single Track","type":"heading","anchor":"Scrobbling-a-Single-Track","level":3},{"type":"paragraph","inlineContent":[{"text":"To scrobble a single track, you can use the ","type":"text"},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method with an array containing just one "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKTrackToScrobble","isActive":true},{"type":"text","text":":"}]},{"code":["let track = SBKTrackToScrobble(","    artist: \"Daft Punk\",","    track: \"One More Time\",","    timestamp: Date(),","    album: \"Discovery\"",")","","do {","    let response = try await manager.scrobble(tracks: [track])","    ","    if response.isCompletelySuccessful {","        print(\"Track scrobbled successfully!\")","    } else {","        if let result = response.results.first {","            if result.isAccepted {","                print(\"Scrobbled: \\(result.track.artist) - \\(result.track.track)\")","                if let correctedArtist = result.correctedArtist {","                    print(\"Artist corrected to: \\(correctedArtist)\")","                }","                if let correctedTrack = result.correctedTrack {","                    print(\"Track corrected to: \\(correctedTrack)\")","                }","            } else if let error = result.error {","                print(\"Failed to scrobble \\(result.track.artist) - \\(result.track.track): \\(error.rawValue)\")","            }","        }","    }","} catch {","    \/\/ Handle scrobbling error","}"],"type":"codeListing","syntax":"swift"},{"text":"Scrobbling Multiple Tracks","type":"heading","anchor":"Scrobbling-Multiple-Tracks","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To scrobble multiple tracks at once, use the "},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method:"}]},{"code":["let tracks: [SBKTrackToScrobble] = [","    SBKTrackToScrobble(artist: \"Daft Punk\", track: \"One More Time\", timestamp: Date(), album: \"Discovery\"),","    SBKTrackToScrobble(artist: \"Daft Punk\", track: \"Harder, Better, Faster, Stronger\", timestamp: Date(), album: \"Discovery\")","]","","do {","    let response = try await manager.scrobble(tracks: tracks)","    ","    if response.isCompletelySuccessful {","        print(\"All tracks scrobbled successfully!\")","    } else {","        print(\"Accepted: \\(response.acceptedCount), Ignored: \\(response.ignoredCount)\")","        ","        for result in response.results {","            if result.isAccepted {","                print(\"Scrobbled: \\(result.track.artist) - \\(result.track.track)\")","            } else if let error = result.error {","                print(\"Failed to scrobble \\(result.track.artist) - \\(result.track.track): \\(error.rawValue)\")","            }","        }","    }","} catch {","    \/\/ Handle scrobbling error","}"],"type":"codeListing","syntax":"swift"},{"text":"Handling the response","type":"heading","anchor":"Handling-the-response","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"scrobble(tracks:)"},{"type":"text","text":" method returns an "},{"type":"codeVoice","code":"SBKScrobbleResponse"},{"type":"text","text":" object, which contains:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"results","type":"codeVoice"},{"text":": An array of ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","isActive":true,"type":"reference"},{"text":" objects, one for each track attempted to be scrobbled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"acceptedCount","type":"codeVoice"},{"text":": The number of tracks successfully scrobbled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ignoredCount","type":"codeVoice"},{"text":": The number of tracks that failed to scrobble.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isCompletelySuccessful","type":"codeVoice"},{"text":": A boolean indicating if all tracks were successfully scrobbled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"acceptedScrobbles","type":"codeVoice"},{"text":": An array of ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","isActive":true,"type":"reference"},{"text":" objects for successfully scrobbled tracks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ignoredScrobbles","type":"codeVoice"},{"text":": An array of ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResult","isActive":true,"type":"reference"},{"text":" objects for tracks that failed to scrobble.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"SBKScrobbleResult"},{"type":"text","text":" contains:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"track","type":"codeVoice"},{"text":": The ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKTrackToScrobble","isActive":true,"type":"reference"},{"text":" object that was attempted to be scrobbled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"isAccepted","type":"codeVoice"},{"text":": A boolean indicating if the track was successfully scrobbled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"error","type":"codeVoice"},{"text":": An ","type":"text"},{"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleError","isActive":true,"type":"reference"},{"text":" object if the scrobble failed, ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" otherwise.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"correctedTrack","type":"codeVoice"},{"text":", ","type":"text"},{"code":"correctedArtist","type":"codeVoice"},{"text":", ","type":"text"},{"code":"correctedAlbum","type":"codeVoice"},{"text":", ","type":"text"},{"code":"correctedAlbumArtist","type":"codeVoice"},{"text":": Corrected values if Last.fm made any corrections.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can scrobble up to 50 tracks in a single request. Attempting to scrobble more than 50 tracks will result in a "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKClientError\/tooManyTracks","isActive":true},{"type":"text","text":" error."}]},{"text":"Convenience Methods","type":"heading","anchor":"Convenience-Methods","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager","isActive":true},{"type":"text","text":" provides two convenience methods for checking scrobble results:"}]},{"code":["\/\/ Check if a specific track was successfully scrobbled","let wasScrobbled = manager.scrobbledSuccessfully(tracks[0], in: response)","","\/\/ Get the error for a specific track, if any","if let error = manager.errorFor(tracks[1], in: response) {","    print(\"Scrobble failed: \\(error.rawValue)\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These methods provide a quick way to check if the single track was scrobbled successfully or if there was an error."}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/scrobblekit\/scrobbling"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKScrobbleResponse","doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKManager\/scrobble(tracks:)"],"title":"Track Scrobbling","anchor":"Track-Scrobbling","generated":true}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"ScrobbleKit"}],"title":"Scrobbling Tracks"},"hierarchy":{"paths":[["doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/Scrobbling"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://ScrobbleKit/documentation/ScrobbleKit/SBKTrackToScrobble":{"abstract":[{"text":"Represents a track to be scrobbled to Last.fm.","type":"text"}],"identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit\/SBKTrackToScrobble","url":"\/documentation\/scrobblekit\/sbktracktoscrobble","title":"SBKTrackToScrobble","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SBKTrackToScrobble","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"SBKTrackToScrobble","kind":"identifier"}]},"doc://ScrobbleKit/documentation/ScrobbleKit":{"kind":"symbol","title":"ScrobbleKit","abstract":[{"type":"text","text":"Streamlined interaction with Last.fm on Apple platforms"}],"type":"topic","identifier":"doc:\/\/ScrobbleKit\/documentation\/ScrobbleKit","url":"\/documentation\/scrobblekit","role":"collection"},"doc://ScrobbleKit/documentation/ScrobbleKit/SBKClientError/tooManyTracks":{"fragments":[{"text":"case","kind":"keyword"},{"te